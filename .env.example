# Public website URL - no trailing slash
PUBLIC_BASE_URL=https://your-zombi-site.example.com
DISCORD_CALLBACK_URL=https://your-zombi-site.example.com/auth/discord/callback

# Discord Application
DISCORD_CLIENT_ID=YOUR_APPLICATION_ID
DISCORD_CLIENT_SECRET=YOUR_OAUTH_CLIENT_SECRET

# Bot token is used by WEBSITE for Discord REST only (no Gateway connection)
BOT_TOKEN=YOUR_BOT_TOKEN

# Your Discord user id(s), comma separated
OWNER_IDS=YOUR_DISCORD_USER_ID

# Long random value
SESSION_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Same PostgreSQL database URL must be used by the bot on Lunafy
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_SSL=true

PORT=3000
HOST=0.0.0.0
PREMIUM_PURCHASE_URL=
